FROM python:3.11-slim

RUN pip install --no-cache-dir \
    dagster==1.13.26 \
    dagster-webserver==1.13.26 \
    dagster-postgres==0.29.26 \
    pandas==2.3.3 \
    boto3==1.40.58 \
    psycopg[binary]==3.2.12

RUN groupadd --gid 1000 lakehouse && useradd --uid 1000 --gid 1000 --create-home lakehouse \
    && mkdir -p /opt/dagster/dagster_home /opt/dagster/app /tmp/dagster \
    && chown -R lakehouse:lakehouse /opt/dagster /tmp/dagster

COPY --chown=lakehouse:lakehouse src/dagster/ /opt/dagster/app/lakehouse/
COPY --chown=lakehouse:lakehouse config/dagster.yaml /opt/dagster/dagster_home/dagster.yaml
COPY --chown=lakehouse:lakehouse config/workspace.yaml /opt/dagster/dagster_home/workspace.yaml

ENV DAGSTER_HOME=/opt/dagster/dagster_home \
    PYTHONPATH=/opt/dagster/app \
    HOME=/home/lakehouse
WORKDIR /opt/dagster/dagster_home
USER 1000:1000
EXPOSE 3000
CMD ["dagster-webserver", "-h", "0.0.0.0", "-p", "3000", "-w", "workspace.yaml"]
