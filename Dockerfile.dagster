FROM python:3.10-slim

# Install Dagster packages and envsubst via pip
RUN pip install \
    dagster \
    dagster-graphql \
    dagster-webserver \
    dagster-postgres \
    dagster-spark \
    dagster-dbt \
    envsubst

# Set DAGSTER_HOME and create directory
ENV DAGSTER_HOME=/opt/dagster/dagster_home
RUN mkdir -p $DAGSTER_HOME

# Copy configuration files from src/dagster
COPY src/dagster/workspace.yaml $DAGSTER_HOME/
COPY src/dagster/dagster.yaml.template $DAGSTER_HOME/

# Set working directory
WORKDIR $DAGSTER_HOME

# Expose port
EXPOSE 3000

# Start Dagster
CMD ["dagster", "dev", "--host", "0.0.0.0", "--port", "3000"] 
