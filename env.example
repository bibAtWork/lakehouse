# =============================================================================
# LOCAL DEVELOPMENT CONFIGURATION
# =============================================================================

# Spark Configuration (Local)
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2

# Database Configuration (Local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lakehouse
DB_USER=lakehouse
DB_PASSWORD=your_secure_password_here

# Storage Configuration (Local MinIO)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=your_secure_minio_password_here
S3_BUCKET=lakehouse-data

# Unity Catalog Configuration (Local)
UNITY_CATALOG_HOST=http://unity-catalog:8080
UNITY_CATALOG_CATALOG=main
UNITY_CATALOG_SCHEMA=default
UNITY_CATALOG_METADATA_DB_HOST=postgres
UNITY_CATALOG_METADATA_DB_PORT=5432
UNITY_CATALOG_METADATA_DB_NAME=lakehouse
UNITY_CATALOG_METADATA_DB_USER=lakehouse
UNITY_CATALOG_METADATA_DB_PASSWORD=your_secure_password_here

# Dagster Configuration
DAGSTER_HOME=./dagster_home
DAGSTER_ENV=development

# Application Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development

# =============================================================================
# DATABRICKS CONFIGURATION (OPTIONAL - FOR PRODUCTION)
# =============================================================================
# Uncomment and configure these for Databricks deployment

# Databricks Configuration
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=your-databricks-token
# DATABRICKS_CLUSTER_ID=your-cluster-id

# Unity Catalog Configuration (Databricks only)
# UNITY_CATALOG_WAREHOUSE=your-warehouse-id

# =============================================================================
# DEPLOYMENT MODE
# =============================================================================
# Set to 'local' for local development, 'databricks' for cloud deployment
DEPLOYMENT_MODE=local 